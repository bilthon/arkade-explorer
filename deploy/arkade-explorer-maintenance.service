[Unit]
Description=Arkade Explorer — periodic fee + sweep maintenance
Documentation=https://github.com/bilthon/arkade-explorer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=arkade
Group=arkade
WorkingDirectory=/opt/arkade-explorer

# Same operator + shared database as the other units.
Environment=ARK_URL=https://arkade.computer
Environment=DB_PATH=/var/lib/arkade-explorer/data.db

# Three catch-up passes. The leading '-' lets each run independently: a failure in one
# (e.g. a transient indexer/esplora error) does not block the others. Adjust node path if needed.
ExecStart=-/usr/bin/node --experimental-sqlite src/ingest.js --backfill-fees
ExecStart=-/usr/bin/node --experimental-sqlite src/ingest.js --refresh-sweeps
ExecStart=-/usr/bin/node --experimental-sqlite src/ingest.js --backfill-inputs

StateDirectory=arkade-explorer

# Hardening (matches the ingest/serve units)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/arkade-explorer
